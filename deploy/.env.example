# Copy to a PRIVATE file on Ubuntu or enter values in Portainer. Never commit real values.
API_IMAGE=yorungez-api:replace-with-commit-sha
WEB_IMAGE=yorungez-web:replace-with-commit-sha
API_LOG_LEVEL=Information
TRAEFIK_NETWORK=replace-with-existing-network-name
TRAEFIK_IP=replace-with-exact-traefik-container-ip
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=replace-with-existing-resolver
APP_SUBNET=10.89.0.0/24
API_INTERNAL_IP=10.89.0.2
WEB_INTERNAL_IP=10.89.0.3
# Generate independent hex secrets on the SERVER (openssl rand -hex 32/64).
# Hex avoids connection-string delimiters and Compose interpolation in secrets.
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
JWT_SIGNING_KEY=replace-me
KEYRING_CERT_PASSWORD=replace-me
KEYRING_PATH=/opt/yorungez/private/keys
KEYRING_CERT_PATH=/opt/yorungez/private/keyring.pfx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=sender@example.com
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-private-app-password
