# Server-only optional settings. No credentials are needed for the bundled map.
YORUNGEZ_ENABLE_LAB=0
# Server-side only. Backend must also set Email:FrontendBaseUrl to the public web origin.
YORUNGEZ_API_ORIGIN=http://127.0.0.1:5187
# Set explicitly to the public HTTPS origin when deployed behind a reverse proxy.
# YORUNGEZ_WEB_ORIGIN=https://yorungez.com
