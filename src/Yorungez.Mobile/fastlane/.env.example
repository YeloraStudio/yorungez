# Copy to .env locally; never commit real credentials or private signing files.
# Keep the registered bundle identifier com.yelorastudio.yorungez.
IOS_TEAM_ID=
IOS_PROFILE_NAME=
# Xcode identity selector. IPA verification resolves its SHA-256 from Keychain.
IOS_SIGNING_CERT_SHA1=
IOS_VERSION=0.1.0
# Must be unused in App Store Connect; increment for every upload.
IOS_BUILD_NUMBER=4
# Team API key: private .p8 file outside Git, not the key contents.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
# Optional absolute path to the project's pinned Flutter executable.
# FLUTTER_BIN=/path/to/flutter/bin/flutter
