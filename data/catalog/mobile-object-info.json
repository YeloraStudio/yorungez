  "descriptions": {
    "sun": {
      "text": {
        "en": "Star at the centre of the Solar System",
        "tr": "Güneş Sistemi’nin merkezindeki yıldız"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/sun/"
        }
      ]
    },
    "moon": {
      "text": {
        "en": "Natural satellite of the Earth",
        "tr": "Dünya’nın doğal uydusu"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/moon/"
        }
      ]
    },
    "mercury": {
      "text": {
        "en": "Closest planet to the Sun",
        "tr": "Güneş’e en yakın gezegen"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/mercury/"
        }
      ]
    },
    "venus": {
      "text": {
        "en": "Second planet from the Sun",
        "tr": "Güneş’e uzaklıkta ikinci gezegen"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/venus/"
        }
      ]
    },
    "mars": {
      "text": {
        "en": "Fourth planet from the Sun",
        "tr": "Güneş’e uzaklıkta dördüncü gezegen"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/mars/"
        }
      ]
    },
    "jupiter": {
      "text": {
        "en": "Largest planet in the Solar System",
        "tr": "Güneş Sistemi’nin en büyük gezegeni"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/jupiter/"
        }
      ]
    },
    "saturn": {
      "text": {
        "en": "Gas giant with a prominent ring system",
        "tr": "Belirgin halka sistemine sahip gaz devi"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/saturn/"
        }
      ]
    },
    "uranus": {
      "text": {
        "en": "Ice giant with a strongly tilted rotation axis",
        "tr": "Dönme ekseni çok eğik olan buz devi"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/uranus/"
        }
      ]
    },
    "neptune": {
      "text": {
        "en": "Outermost planet in the Solar System",
        "tr": "Güneş Sistemi’nin en dıştaki gezegeni"
      },
      "sources": [
        {
          "label": "NASA Science",
          "url": "https://science.nasa.gov/neptune/"
        }
      ]
    }
  },
