# Generate private local values with scripts/Initialize-LocalEnvironment.ps1.
POSTGRES_PASSWORD=replace-with-random-local-password
REDIS_PASSWORD=replace-with-random-local-password
POSTGRES_PORT=15432
REDIS_PORT=16379
SMTP_PORT=1029
MAILPIT_PORT=8029
JWT_SIGNING_KEY=replace-with-at-least-64-random-bytes
# Backend SMTP only. Keep the real password only in private .env or the server's secret environment.
EMAIL__HOST=smtp.gmail.com
EMAIL__PORT=587
EMAIL__SENDER=sender@example.com
EMAIL__USERNAME=sender@example.com
EMAIL__PASSWORD=
EMAIL__REQUIRETLS=true
EMAIL__RUNOUTBOXWORKER=true
